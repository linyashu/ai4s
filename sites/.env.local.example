# DeepSeek API 密钥（必填）
DEEPSEEK_API_KEY=
# 可选：LLM 模型名
# LLM_MODEL=deepseek-chat
# 可选：LLM 价格（每百万 token 美元，用于成本统计）
# LLM_INPUT_PRICE_PER_M=0.27
# LLM_OUTPUT_PRICE_PER_M=1.1
# 可选：X/Twitter API Bearer Token（配置后启用 X 信源，需付费 Basic 层）
# X_BEARER_TOKEN=
# 可选：ingest 管理 API 访问密钥（未配置时 /api/ingest 等管理接口一律禁用）
# INGEST_SECRET=
# 可选：无 key 时用启发式规则
# LLM_MOCK=1
# 可选：两阶段管线每次粗选候选上限（默认 10）
# CANDIDATE_LIMIT=10
# 可选：Firecrawl API key（真实浏览器渲染，解决 SPA 排行榜/全文抓取反爬）
# FIRECRAWL_API_KEY=
# 可选：GitHub API Token（提升 Search API 限额，未认证 10 次/分）
# GITHUB_TOKEN=
# 可选：图片代理签名密钥（配置后启用 /api/img-proxy，不配置则代理禁用）
# IMG_PROXY_SECRET=
# 可选：站点对外 URL（RSS/sitemap/SEO 使用，含 basePath 前缀）
# SITE_URL=https://your-domain.com
# 可选：ingest 完成后自动刷新（设 0 禁用）
# REFRESH_RANKINGS=1
# REFRESH_GITHUB=1
# REFRESH_OPENROUTER=1
# 可选：数据目录（默认 ./data）
# DATA_DIR=

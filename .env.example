# ===== LLM 摘要（OpenAI 兼容接口）=====
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-your-key-here
LLM_MODEL=deepseek-chat

# 可选：留空则仅聚合不摘要
# LLM_TEMPERATURE=0.3

# ===== Jina Reader（全文抓取 / 排行榜页面渲染）=====
# 免费 API key（jina.ai 获取）。配置后：
# - 全文抓取与 SPA 页面渲染（如 OpenCompass 司南）更稳定，避免匿名档限流
# JINA_API_KEY=jina_xxx

# ===== Firecrawl（推荐，优先于 Jina）=====
# 真实无头浏览器渲染，对 JS 动态加载的页面（如 OpenCompass 司南）抓取稳定。
# 配置后自动优先使用，Jina 作为兜底。免费档每月约 500 次抓取。
# FIRECRAWL_API_KEY=fc-xxx
